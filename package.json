{
  "name": "infinite-canvas",
  "displayName": "Infinite Canvas Cinema",
  "description": "Canvas reference boards with image tags, captions, clipboard copying and JSON/YAML tag export. Fork of Infinite Canvas.",
  "version": "0.1.7",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Notebooks"
  ],
  "icon": "icon.png",
  "keywords": [
    "obsidian",
    "obsidian-canvas",
    "canvas",
    "visual",
    "mind map",
    "diagram",
    "knowledge management",
    "note taking",
    "pkm",
    "ai",
    "markdown",
    "graph",
    "visualization",
    "workflow"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:infinite-canvas.canvasEditor",
    "onLanguage:canvas"
  ],
  "contributes": {
    "languages": [
      {
        "id": "canvas",
        "aliases": [
          "Canvas",
          "canvas"
        ],
        "extensions": [
          ".canvas"
        ],
        "mimetypes": [
          "application/json"
        ],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "infinite-canvas.canvasEditor",
        "displayName": "Infinite Canvas Cinema",
        "selector": [
          {
            "filenamePattern": "*.canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.canvas": "canvas"
      },
      "workbench.editorAssociations": {
        "*.canvas": "infinite-canvas.canvasEditor"
      }
    },
    "commands": [
      {
        "command": "infinite-canvas.newCanvas",
        "title": "New Canvas",
        "category": "Infinite Canvas"
      },
      {
        "command": "infinite-canvas.setTag",
        "title": "Set tag",
        "category": "Infinite Canvas"
      },
      {
        "command": "infinite-canvas.copyTag",
        "title": "Copy @tag",
        "category": "Infinite Canvas"
      },
      {
        "command": "infinite-canvas.exportTags",
        "title": "Export tags",
        "category": "Infinite Canvas"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "infinite-canvas.newCanvas",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "infinite-canvas.exportTags",
          "when": "activeCustomEditorId == infinite-canvas.canvasEditor",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "infinite-canvas.setTag",
          "when": "activeCustomEditorId == infinite-canvas.canvasEditor",
          "group": "1_modification"
        },
        {
          "command": "infinite-canvas.copyTag",
          "when": "activeCustomEditorId == infinite-canvas.canvasEditor",
          "group": "1_modification"
        },
        {
          "command": "infinite-canvas.exportTags",
          "when": "activeCustomEditorId == infinite-canvas.canvasEditor",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Infinite Canvas",
      "properties": {
        "infinite-canvas.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key for AI-powered idea generation (optional - fallback to mock responses if not provided)",
          "markdownDescription": "OpenRouter API key for AI-powered idea generation. Get your free API key at [openrouter.ai](https://openrouter.ai). If not provided, the extension will use mock responses."
        },
        "infinite-canvas.useLegacyTagExportNames": {
          "type": "boolean",
          "default": false,
          "description": "Use shared tags.json/tags.yaml export filenames instead of canvas-specific filenames."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/regression.cjs"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4",
    "yaml": "2.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KEMBL/infinite-canvas-cinema"
  },
  "homepage": "https://github.com/KEMBL/infinite-canvas-cinema#readme",
  "bugs": {
    "url": "https://github.com/KEMBL/infinite-canvas-cinema/issues"
  },
  "publisher": "LuisFernando",
  "license": "MIT",
  "author": {
    "name": "Infinite Canvas Team"
  },
  "galleryBanner": {
    "color": "#2D3748",
    "theme": "dark"
  }
}
